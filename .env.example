# Copy to .env.local and fill in. .env.local is git-ignored.

# Firebase console → Project settings → General → Your apps → (web app) → SDK setup and configuration → Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Your account's UID. Sign in once; the app shows it. `npm run deploy` writes it into the database rules.
# Empty = the database denies everyone.
OWNER_UID=

# true = use local Firebase emulators (npm run emulators) instead of the real project.
VITE_USE_EMULATORS=false
